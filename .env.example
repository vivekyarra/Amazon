APP_ENV=development
HOST=127.0.0.1
PORT=8080
GUIDED_MODE=true
DATA_DIR=.local
# Optional owner/judge bootstrap passwords; otherwise generated in private .local/access.json.
# JUDGE_PASSWORD=
# OWNER_PASSWORD=
# BEE_TOKEN=
# RING_ACCESS_TOKEN=
# RING_HMAC_KEY=
# Live device connections are not required for the guided judge replay.
# Optional guarded live pilot (separate DATA_DIR, no judge account):
# GUIDED_MODE=false
# ALLOWED_ORIGINS=https://your-owned-hostname.example
# LEDGER_KEY_FILE=/private/path/to/32-byte-mode-0600-key
# RING_BINDINGS_FILE=/private/path/to/ring-bindings.json
# POSE_MODEL_FILE=/private/path/to/pose_landmarker_lite.task
# POSE_MODEL_SHA256=59929e1d1ee95287735ddd833b19cf4ac46d29bc7afddbbf6753c459690d574a
# BEE_HOUSEHOLD=house_owner
# Optional AWS projection/scheduler, all fields required together; use an instance role:
# AWS_REGION=ap-south-1
# AWS_LEDGER_TABLE=
# S3_EVIDENCE_BUCKET=
# AWS_WAKE_QUEUE_URL=
# AWS_WAKE_QUEUE_ARN=
# AWS_SCHEDULER_ROLE_ARN=
